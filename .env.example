# Runtime. Keep APP_ENV=development while binding directly to localhost.
APP_ENV=development
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=replace-with-a-long-random-value
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_SECURE_COOKIES=false
SESSION_COOKIE_AGE=28800

# The web port is published only on loopback by default.
HOST_BIND=127.0.0.1
WEB_PORT=8000

# Local infrastructure. PostgreSQL and Redis are not published to the host.
POSTGRES_DB=contact_outreach
POSTGRES_USER=contact_outreach
POSTGRES_PASSWORD=replace-with-a-local-database-password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
REDIS_URL=redis://redis:6379/0
PRIVATE_STORAGE_ROOT=/app/private

# Single owner bootstrap. Values are read from the environment and never logged.
OWNER_USERNAME=owner
OWNER_EMAIL=
OWNER_PASSWORD=replace-with-a-strong-owner-password

# Safety controls: these defaults must remain safe.
SEND_MODE=dry-run
SEND_KILL_SWITCH=true
EXTRACTOR_PROVIDER=fake
# Sólo es necesaria al seleccionar Outscraper. Nunca se persiste ni se muestra.
OUTSCRAPER_API_KEY=
OUTSCRAPER_BASE_URL=https://api.outscraper.cloud
# Reserva conservadora configurable; revisar contra precios vigentes antes de live.
OUTSCRAPER_MAX_COST_PER_RESULT=0.010000
OUTSCRAPER_BATCH_SIZE=20
OUTSCRAPER_POLL_SECONDS=30
# `http` habilita fetch HTML/texto con DNS/IP fijada y protección SSRF.
WEBSITE_FETCHER=fake
# La campaña elige fake, ollama u openai-compatible; las claves sólo viven aquí.
LLM_PROVIDER=fake
LLM_MODEL=fake-deterministic
LLM_API_KEY=
OLLAMA_BASE_URL=http://127.0.0.1:11434
OPENAI_COMPATIBLE_BASE_URL=
GMAIL_PROVIDER=fake

# Optional demo owner. It is loaded only by `make demo`, never at startup.
ALLOW_DEMO_DATA=false
DEMO_OWNER_USERNAME=demo
DEMO_OWNER_EMAIL=demo@example.invalid
DEMO_OWNER_PASSWORD=
