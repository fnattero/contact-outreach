# Runtime. Keep APP_ENV=development while binding directly to localhost.
APP_ENV=development
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=replace-with-a-long-random-value
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_SECURE_COOKIES=false
DJANGO_SSL_REDIRECT=false
DJANGO_HSTS_SECONDS=0
DJANGO_HSTS_INCLUDE_SUBDOMAINS=false
DJANGO_HSTS_PRELOAD=false
# Sólo habilitar detrás de un proxy conocido que agregue X-Forwarded-Proto.
DJANGO_PROXY_HTTPS=false
# Railway public networking envía X-Forwarded-Proto=https y X-Railway-Request-Id.
# Sólo usar este modo en el servicio web público de Railway.
DJANGO_RAILWAY_PROXY=false
DJANGO_TRUSTED_PROXY_IPS=
PUBLIC_BASE_URL=
RAILWAY_PUBLIC_DOMAIN=
SESSION_COOKIE_AGE=28800

# The web port is published only on loopback by default.
HOST_BIND=127.0.0.1
WEB_PORT=8000

# Local infrastructure. PostgreSQL and Redis are not published to the host.
POSTGRES_DB=contact_outreach
POSTGRES_USER=contact_outreach
POSTGRES_PASSWORD=replace-with-a-local-database-password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# En Railway preferir DATABASE_URL=${{Postgres.DATABASE_URL}} y no exponer Postgres por TCP.
DATABASE_URL=
REDIS_URL=redis://redis:6379/0
PRIVATE_STORAGE_ROOT=/app/private
# Las cargas se rechazan antes de agotar este margen; ENOSPC también se captura atómicamente.
MIN_FREE_DISK_BYTES=104857600

# First administrator bootstrap. Values are read from the environment and never logged.
OWNER_USERNAME=owner
OWNER_EMAIL=
OWNER_PASSWORD=replace-with-a-strong-owner-password
# En producción las migraciones se ejecutan con el pre-deploy command de Railway.
RUN_MIGRATIONS_ON_STARTUP=true
RUN_OWNER_BOOTSTRAP_ON_STARTUP=true

# Safety controls: these defaults must remain safe.
SEND_MODE=dry-run
SEND_KILL_SWITCH=true
AUTO_REPLY_KILL_SWITCH=true
RELATIONSHIP_KILL_SWITCH=true
AUTOMATIC_REPLY_CONVERSATION_DAILY_LIMIT=3
AUTOMATIC_REPLY_WORKSPACE_DAILY_LIMIT=20
# El extractor (`fake|overture`), la confianza y la sincronización se configuran en el dashboard.
# Overture no acepta API key, URL, bucket ni credenciales configurables.
# Fallback previo a configurar el lector web desde Integraciones en el dashboard.
# `http` habilita fetch HTML/texto con DNS/IP fijada y protección SSRF.
WEBSITE_FETCHER=fake
# `dns` valida en segundo plano los emails agregados manualmente; `mock` es sólo para pruebas.
CONTACT_EMAIL_MX_RESOLVER=dns
# LLM y Gmail se configuran desde Integraciones en el dashboard.
EMBEDDING_PROVIDER=fake
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
# Raíz externa para refresh tokens y credenciales de integración. No reutilizar DJANGO_SECRET_KEY.
FIELD_ENCRYPTION_KEY=
GMAIL_FAKE_ACCOUNT_EMAIL=owner@example.invalid

# Optional demo owner. It is loaded only by `make demo`, never at startup.
ALLOW_DEMO_DATA=false
DEMO_OWNER_USERNAME=demo
DEMO_OWNER_EMAIL=demo@example.invalid
DEMO_OWNER_PASSWORD=
