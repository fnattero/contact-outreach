# Public frontend and private proxy boundary.
PUBLIC_APP_ORIGIN=http://localhost:3000
INTERNAL_PROXY_TOKEN=replace-with-a-long-random-proxy-token
FRONTEND_BIND=127.0.0.1
FRONTEND_PORT=3000
BACKEND_BIND=127.0.0.1
BACKEND_PORT=8001

# Django runtime. Production requires exact HTTPS host/origin settings.
APP_ENV=development
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=replace-with-a-long-random-value
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
DJANGO_SECURE_COOKIES=false
DJANGO_SSL_REDIRECT=false
DJANGO_HSTS_SECONDS=0
DJANGO_HSTS_INCLUDE_SUBDOMAINS=false
DJANGO_HSTS_PRELOAD=false
DJANGO_PROXY_HTTPS=false
DJANGO_RAILWAY_PROXY=false
DJANGO_TRUSTED_PROXY_IPS=
PUBLIC_BASE_URL=
SESSION_COOKIE_AGE=43200

# PostgreSQL. Railway should inject distinct runtime and migration URLs directly.
POSTGRES_DB=contact_outreach
POSTGRES_USER=contact_outreach
POSTGRES_PASSWORD=replace-with-a-local-database-password
DATABASE_URL=
MIGRATION_DATABASE_URL=

# Redis logical databases: broker 0, cache 1, short-lived results 2.
CELERY_BROKER_URL=redis://redis:6379/0
CACHE_REDIS_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# Local private S3-compatible storage. No anonymous bucket policy is created.
PRIVATE_STORAGE_BACKEND=s3
MINIO_ROOT_USER=contact-outreach-local
MINIO_ROOT_PASSWORD=replace-with-a-local-minio-password
MINIO_BIND=127.0.0.1
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY_ID=contact-outreach-local
S3_SECRET_ACCESS_KEY=replace-with-a-local-minio-password
S3_BUCKET_NAME=contact-outreach-private
S3_REGION_NAME=us-east-1
S3_ADDRESSING_STYLE=path

# Unified backend process defaults.
WEB_CONCURRENCY=2
CELERY_WORKER_CONCURRENCY=2
CELERY_LOG_LEVEL=INFO
DEPENDENCY_WAIT_SECONDS=60
BACKEND_TMP_SIZE=2g
RUN_MIGRATIONS_ON_STARTUP=true
RUN_OWNER_BOOTSTRAP_ON_STARTUP=true

# One-time local first-admin bootstrap. Remove production bootstrap values after use.
OWNER_USERNAME=owner
OWNER_EMAIL=
OWNER_PASSWORD=replace-with-a-strong-owner-password

# Safety controls. These defaults must remain closed.
SEND_MODE=dry-run
SEND_KILL_SWITCH=true
AUTO_REPLY_KILL_SWITCH=true
RELATIONSHIP_KILL_SWITCH=true
AUTOMATIC_REPLY_CONVERSATION_DAILY_LIMIT=3
AUTOMATIC_REPLY_WORKSPACE_DAILY_LIMIT=20

# Providers remain fake unless explicitly configured in a controlled environment.
WEBSITE_FETCHER=fake
CONTACT_EMAIL_MX_RESOLVER=dns
LLM_PROVIDER=fake
LLM_MODEL=fake-deterministic
LLM_API_KEY=
EMBEDDING_PROVIDER=fake
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
GMAIL_PROVIDER=fake
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=
GMAIL_OAUTH_REDIRECT_URI=http://localhost:3000/api/v1/integrations/gmail/oauth/callback/
FIELD_ENCRYPTION_KEY=
GMAIL_FAKE_ACCOUNT_EMAIL=owner@example.invalid

# Optional demo owner. Loaded only through `make demo` in development.
ALLOW_DEMO_DATA=false
DEMO_OWNER_USERNAME=demo
DEMO_OWNER_EMAIL=demo@example.invalid
DEMO_OWNER_PASSWORD=
